<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_user_activity" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.user.activity</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="Atividade de Usuários"
                    string="Atividade de Usuários"
                    data-key="noc_user_activity"
                >
                    <h2>Atividade de Usuários</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label
                                    for="noc_user_activity_inactivity_timeout_minutes"
                                    string="Timeout de Inatividade (min)"
                                />
                                <div class="text-muted">
                                    Minutos sem atividade antes do logout automático. Padrão: 30.
                                </div>
                                <div class="content-group mt8">
                                    <field
                                        name="noc_user_activity_inactivity_timeout_minutes"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label
                                    for="noc_user_activity_warning_before_logout_minutes"
                                    string="Aviso antes do Logout (min)"
                                />
                                <div class="text-muted">
                                    Minutos de antecedência em que o aviso de logout é exibido. Padrão: 2.
                                </div>
                                <div class="content-group mt8">
                                    <field
                                        name="noc_user_activity_warning_before_logout_minutes"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
