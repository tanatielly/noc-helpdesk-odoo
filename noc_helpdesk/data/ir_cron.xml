<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

        <record id="ir_cron_helpdesk_stale_ticket_notification" model="ir.cron">
            <field name="name">Helpdesk - Notify Stale Tickets</field>
            <field name="model_id" ref="noc_helpdesk.model_helpdesk_ticket" />
            <field name="state">code</field>
            <field name="code">model.cron_notify_inactive_tickets()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>

