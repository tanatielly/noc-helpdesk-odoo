<odoo>
    <record id="action_reassign_odoobot_tickets" model="ir.actions.server">
        <field name="name">Reatribuir tickets OdooBot ao plantão atual</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
        <field name="binding_model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">model.action_reassign_odoobot_tickets()</field>
    </record>

    <record id="action_force_escala_plantao" model="ir.actions.server">
        <field name="name">Assumir plantão pela escala agora</field>
        <field name="model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
        <field name="binding_model_id" ref="helpdesk_mgmt.model_helpdesk_ticket" />
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">model.action_force_escala_plantao()</field>
    </record>
</odoo>
