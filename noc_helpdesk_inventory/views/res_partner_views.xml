<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_provider_circuits" model="ir.ui.view">
        <field name="name">res.partner.provider.circuits</field>
        <field name="model">res.partner</field>
        <field
            name="inherit_id"
            ref="noc_contacts.view_partner_company_form_inherit_noc"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_clients']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='page_clients']" position="after">
                <page
                    string="Circuitos"
                    name="page_circuits"
                    attrs="{'invisible': [('noc_type', '!=', 'provider')]}"
                >
                    <field name="circuit_ids" mode="tree" nolabel="1">
                        <tree create="0">
                            <field name="link_designation" string="Designação" />
                            <field name="name" string="Nome" />
                            <field name="link_speed" string="Velocidade" />
                            <field name="ticket_count" string="Chamados" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
