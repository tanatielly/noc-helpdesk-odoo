<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form_circuit_api" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.circuit.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div
                    class="app_settings_block"
                    data-string="API de Circuitos"
                    string="API de Circuitos"
                    data-key="noc_helpdesk_inventory"
                >
                    <h2>API de Circuitos</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="circuit_api_token" string="Token da API" />
                                <div class="text-muted">
                                    Header Authorization: Bearer &lt;token&gt; usado por sistemas
                                    externos para consultar chamados em aberto por circuito.
                                </div>
                                <div class="content-group mt8">
                                    <field
                                        name="circuit_api_token"
                                        password="True"
                                        class="o_light_label"
                                    />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
