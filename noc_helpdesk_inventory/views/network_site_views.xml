<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <!-- ── FORM ──────────────────────────────────────────────────────────── -->

    <record id="view_network_site_form" model="ir.ui.view">
        <field name="name">network.site.form</field>
        <field name="model">network.site</field>
        <field name="arch" type="xml">
            <form string="Site">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_equipment"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-plug"
                        >
                            <field
                                name="equipment_count"
                                widget="statinfo"
                                string="Qtd. Equipamentos"
                            />
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Nome do Site" />
                        <h1>
                            <field name="name" placeholder="ex: Site Centro SP" />
                        </h1>
                    </div>
                    <group>
                        <group string="Localização">
                            <field name="address" />
                            <field name="latitude" />
                            <field name="longitude" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipamentos">
                            <field name="equipment_ids">
                                <tree
                                    decoration-success="status == 'active' and not is_danger and not is_deactivating"
                                    decoration-warning="status == 'maintenance'"
                                    decoration-danger="is_danger or is_deactivating"
                                    decoration-muted="status in ('inactive', 'obsolete')"
                                >
                                    <field name="name" />
                                    <field name="equipment_type" />
                                    <field name="brand" />
                                    <field name="model_name" />
                                    <field name="ip_address" />
                                    <field name="location" />
                                    <field
                                        name="status"
                                        widget="badge"
                                        decoration-success="status == 'active'"
                                        decoration-warning="status == 'maintenance'"
                                        decoration-danger="status == 'inactive'"
                                        decoration-muted="status == 'obsolete'"
                                    />
                                    <field name="is_danger" column_invisible="1" />
                                    <field
                                        name="is_deactivating"
                                        column_invisible="1"
                                    />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- ── TREE ──────────────────────────────────────────────────────────── -->

    <record id="view_network_site_tree" model="ir.ui.view">
        <field name="name">network.site.tree</field>
        <field name="model">network.site</field>
        <field name="arch" type="xml">
            <tree js_class="ctrl_click_list">
                <field name="name" />
                <field name="address" />
                <field name="latitude" />
                <field name="longitude" />
                <field name="equipment_count" string="Equipamentos" />
            </tree>
        </field>
    </record>

    <!-- ── SEARCH ────────────────────────────────────────────────────────── -->

    <record id="view_network_site_search" model="ir.ui.view">
        <field name="name">network.site.search</field>
        <field name="model">network.site</field>
        <field name="arch" type="xml">
            <search string="Pesquisar Sites">
                <field
                    name="name"
                    string="Pesquisar"
                    filter_domain="[
                        '|',
                        ('name', 'ilike', self),
                        ('address', 'ilike', self)
                    ]"
                />
            </search>
        </field>
    </record>

    <!-- ── ACTION ────────────────────────────────────────────────────────── -->

    <record id="action_network_site" model="ir.actions.act_window">
        <field name="name">Sites</field>
        <field name="res_model">network.site</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_network_site_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhum site cadastrado ainda
            </p>
            <p>Cadastre os sites com seus equipamentos de rede.</p>
        </field>
    </record>

</odoo>
