<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Kanban View -->
    <record id="view_user_note_kanban" model="ir.ui.view">
        <field name="name">user.note.kanban</field>
        <field name="model">user.note</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="name" />
                <field name="status" />
                <field name="content" />
                <field name="color" />
                <field name="write_date" />
                <templates>
                    <t t-name="kanban-box">
                        <div
                            t-attf-class="oe_kanban_card oe_kanban_global_click o_kanban_record_has_image_fill #{kanban_color(record.color.raw_value)}"
                        >
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name" />
                                        </strong>
                                    </div>
                                    <div class="o_kanban_record_top_right">
                                        <span
                                            t-if="record.status.raw_value == 'draft'"
                                            class="badge rounded-pill text-bg-warning"
                                        >Rascunho</span>
                                        <span
                                            t-if="record.status.raw_value == 'note'"
                                            class="badge rounded-pill text-bg-success"
                                        >Anotação</span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="content" widget="html" readonly="1" />
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left text-muted small">
                                        <i class="fa fa-clock-o me-1" />
                                        <field name="write_date" widget="datetime" />
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <ul
                                            class="oe_kanban_colorpicker"
                                            data-field="color"
                                        />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- List View -->
    <record id="view_user_note_list" model="ir.ui.view">
        <field name="name">user.note.list</field>
        <field name="model">user.note</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field
                    name="status"
                    decoration-warning="status == 'draft'"
                    decoration-success="status == 'note'"
                    widget="badge"
                />
                <field name="write_date" string="Última Modificação" />
                <field name="create_date" string="Criado em" />
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_user_note_form" model="ir.ui.view">
        <field name="name">user.note.form</field>
        <field name="model">user.note</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Título" />
                        <h1>
                            <field name="name" placeholder="Nova Anotação..." />
                        </h1>
                    </div>
                    <group>
                        <field
                            name="status"
                            widget="radio"
                            options="{'horizontal': true}"
                        />
                    </group>
                    <separator />
                    <field
                        name="content"
                        widget="html"
                        placeholder="Escreva sua anotação aqui..."
                    />
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_user_note_search" model="ir.ui.view">
        <field name="name">user.note.search</field>
        <field name="model">user.note</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Título" />
                <separator />
                <filter
                    name="filter_drafts"
                    string="Rascunhos"
                    domain="[('status', '=', 'draft')]"
                />
                <filter
                    name="filter_notes"
                    string="Anotações"
                    domain="[('status', '=', 'note')]"
                />
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_user_note" model="ir.actions.act_window">
        <field name="name">Minhas Anotações</field>
        <field name="res_model">user.note</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_user_note_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nenhuma anotação encontrada.
            </p>
            <p>
                Crie sua primeira anotação ou rascunho clicando em <b>Novo</b>.
            </p>
        </field>
    </record>

</odoo>
